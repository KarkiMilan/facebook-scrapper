{
  "name": "facebook-graphql-scraper-playwright",
  "version": "1.0.0",
  "description": "Facebook GraphQL scraper Playwright (TypeScript)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/parser.test.ts tests/utils.test.ts",
    "scrape": "node src/cli.ts",
    "example": "node src/example.ts",
    "install:chromium": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}